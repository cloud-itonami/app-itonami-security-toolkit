;; nbb does not read deps.edn — it resolves its own nbb.edn from the cwd.
;; Since ecdfee0 (clojure.string -> kotoba.lang.text) the suite requires
;; kotoba.lang.text. This mirrors the coordinate deps.edn pins (8117c9d):
;; same sha floor, same reason — tools.deps takes the newest sha it is shown,
;; so an unpinned ride is silent drift.
;; adr-2609112000 (kbb cutover) renamed the entry points to `kbb --backend
;; sci ...` but the engine is the same nbb runtime (kotoba-lang/org-babashka-nbb),
;; and ADR-2609093000 still holds: .cljs deps are declared here, not deps.edn.
{:deps
 {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.test"}io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}}}
